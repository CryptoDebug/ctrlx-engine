[Unit]
Description=CTRLX Discord Bot
After=network.target

[Service]
Type=simple
User=axellqt
WorkingDirectory=/home/axellqt/CTRLX/Manager Bot
ExecStart=/home/axellqt/CTRLX/venv/bin/python main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
MemoryMax=150M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
